{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "SwiftDM",
  "description": "__MSG_description__",
  "version": "1.2.0",
  "default_locale": "en",
  "author": "Bashar Salmo",
  "homepage_url": "https://github.com/itsmrroot/SwiftDM-release",
  "key": "",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "SwiftDM", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus", "downloads", "nativeMessaging", "storage", "cookies", "webRequest", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }
  ]
}
